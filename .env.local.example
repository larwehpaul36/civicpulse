# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Notifications (see supabase/functions/notify/README.md)
# Public key from: npx web-push generate-vapid-keys   (leave empty to hide the push switch)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Set to 1 only after email sending is set up and the privacy wording is reviewed
NEXT_PUBLIC_EMAIL_NOTICES=0

# Optional email on a resident's account, so reports survive a lost phone (docs/email-signin-setup.md).
# Set to 1 only after custom SMTP is working in Supabase: the built-in email service sends only to your own team members.
NEXT_PUBLIC_EMAIL_ACCOUNTS=0

# Optional. Cloudflare Turnstile (free bot check). Leave empty to keep it off. See docs/turnstile-setup.md
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional. Shown on the Privacy Notice page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Show "Promises kept" (expected fix dates against real fix dates) on the public tracker. Moderators always see it in /admin.
# Leave at 0 for the first month while replies are still relayed by moderators; set to 1 in Vercel Preview first, then Production.
NEXT_PUBLIC_SHOW_PROMISES=0
